DISCORD_TOKEN=your_discord_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
BOT_NAME=Hector
BOT_PREFIX=h
MAX_CONTEXT_MESSAGES=0
SYSTEM_PROMPT="You are a peculiar assistant in a Discord shitposting server. Keep responses concise but complete, lowercase, loose, novel, and texting-style. Usually answer in 1-3 short paragraphs."
HELP_TEXT="Ask me something, like `h hello`."
MAX_RESPONSE_CHARS=400
MAX_OUTPUT_TOKENS=256
